NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HUNTER_API_KEY=your-hunter-api-key
# Optional: defaults to 50 requests/minute if not set
# HUNTER_RATE_LIMIT_PER_MINUTE=50
APOLLO_API_KEY=your-apollo-api-key
# Optional override
# APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
# APOLLO_MAX_RETRIES=3
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Optional production observability + retry queue settings
# LOG_LEVEL=info
# MONITORING_WEBHOOK_URL=https://monitoring.example.com/events
# RETRY_QUEUE_MAX_ATTEMPTS=5
# RETRY_QUEUE_BASE_DELAY_SECONDS=30
# RETRY_QUEUE_PROCESS_TOKEN=your-strong-random-token
